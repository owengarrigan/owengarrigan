# Copy this file to .env and update the values for your camera or test video.

# Use an RTSP URL such as rtsp://user:password@192.168.1.10:554/stream1
# or a local video file path such as ./data/test-video.mp4.
CAMERA_SOURCE=./data/test-video.mp4
CAMERA_NAME=front-gate

# Run detection every N frames to keep edge CPU/GPU usage manageable.
DETECTION_INTERVAL=10

# Standard COCO YOLO model. Ultralytics will download this on first use.
YOLO_MODEL_PATH=yolov8n.pt
PERSON_CONFIDENCE_THRESHOLD=0.5

# Local-only storage.
DATABASE_PATH=./data/events.db
SNAPSHOTS_DIR=./data/events

# FastAPI server settings.
APP_HOST=0.0.0.0
APP_PORT=8000
